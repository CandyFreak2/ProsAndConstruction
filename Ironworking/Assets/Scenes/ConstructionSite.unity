  m_Script: {fileID: 11500000, guid: 10eb693f383f9e94d88d95c2c7bfcc41, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialoguePanel: {fileID: 102539172}
  dialogueText: {fileID: 1766152866}
  dialogue:
  - '"Hi there! I''m the boss around here!"'
  - '"You must be here to work on the building site!"'
  - '"I''m happy to have you here! I love to see young people doing ironworking!"'
  - '"I have a job for you, I need you to go get one of my tools. They should be
    somewhere on the site."'
  - '"Pick up the iron beam next to me, and carry it over to the other side. You
    can climb the beams. Just be sure to be careful!"'
  - '"Good luck! And stay safe! We''re pretty high up!"  '
  startingIndex: 0
  wordSpeed: 0.06
  delayBetweenLines: 3.5
