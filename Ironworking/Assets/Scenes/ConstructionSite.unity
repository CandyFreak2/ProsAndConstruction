  dialoguePanel: {fileID: 972246795}
  dialogueText: {fileID: 1698220414}
  dialogue:
  - '"There''s the welding kit! Now I can show you how to fix these beams."'
  - '"You need to heat them up. This will make the iron soft and easy to move around."  '
  - '"Then, be careful not to touch the hot metal with your hands. Put the pieces
    together, like with glue."'
  - '"And just like that, it''s safe to climb! Now you can keep going! Thank you
    for your help!"'
  startingIndex: 0
  wordSpeed: 0.04
  delayBetweenLines: 2.5
  hasFinishedInteraction: 0
