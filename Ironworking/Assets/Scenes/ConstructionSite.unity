  dialogueText: {fileID: 159310031}
  dialogue:
  - '"You got the wrench, eh? Good work!"'
  - '"This is a big part of ironworking! We can tighten bolts, and put things together!"'
  - '"I can get the elevator working using this wrench. Then, you can go on and keep
    exploring!"'
  - '"Thanks for playing!"'
