--- !u!114 &599520988
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 599520986}
  m_Enabled: 0
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 10eb693f383f9e94d88d95c2c7bfcc41, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialoguePanel: {fileID: 972246795}
  dialogueText: {fileID: 1698220414}
  dialogue:
  - '"There''s the welding kit! Now I can show you how to fix these beams."'
  - '"You need to heat them up. This will make the iron soft and easy to move around."  '
  - '"Then, be careful not to touch the hot metal with your hands. Put the pieces
    together, like with glue."'
  - '"And just like that, it''s safe to climb! Now you can keep going! Thank you
    for your help!"'
  startingIndex: 0
  wordSpeed: 0.04
  delayBetweenLines: 2.5
  hasFinishedInteraction: 0
--- !u!114 &599520989
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 599520986}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 10eb693f383f9e94d88d95c2c7bfcc41, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  dialoguePanel: {fileID: 837517439}
  dialogueText: {fileID: 1507098780}
  dialogue:
  - '"These iron beams are broken, so they can''t be climbed."'
  - '"I can fix it once I have my kit."'
  - '"Welders can get broken pieces back in shape by heating them up. My kit should
    be up that lift."'
  startingIndex: 0
  wordSpeed: 0.04
  delayBetweenLines: 2.5
  hasFinishedInteraction: 0
